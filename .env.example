# GraphSentinel — copy to .env and fill in real values
# Never commit .env to source control

# ── FalkorDB ───────────────────────────────────────────────────────────────
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
FALKORDB_GRAPH=graphsentinel

# ── LLM (Gemini — free tier) ───────────────────────────────────────────────
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── App ────────────────────────────────────────────────────────────────────
APP_PASSWORD=
MAX_REPO_MB=50
MAX_PY_FILES=3000
INGEST_TIMEOUT_S=120
