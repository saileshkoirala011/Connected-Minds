# GraphSentinel — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to source control.

# ── FalkorDB ───────────────────────────────────────────────────────────────
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
# Name of the graph inside FalkorDB (change per environment)
FALKORDB_GRAPH=graphsentinel

# ── Application ────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
# "development" enables hot-reload; "production" disables it
APP_ENV=development

# ── LLM Backend — choose one (all optional; heuristic fallback used if unset)
# OpenAI
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Amazon Bedrock (uses default AWS credential chain if keys are unset)
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ── OSV API ────────────────────────────────────────────────────────────────
# No API key required for public access.
# Increase timeout (seconds) for large batch queries on slow networks.
OSV_REQUEST_TIMEOUT=15

# ── Risk scoring thresholds (override defaults if needed) ──────────────────
RISK_HIGH_THRESHOLD=7.0
RISK_CRITICAL_THRESHOLD=9.0
